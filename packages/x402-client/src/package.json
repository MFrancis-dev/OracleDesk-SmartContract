{
  "name": "@x402/client",
  "version": "1.0.0",
  "description": "Isomorphic TypeScript x402 buyer client with on-chain verification",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./verify": {
      "import": "./dist/verify.js",
      "types": "./dist/verify.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --test dist/**/*.test.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^12.0.0",
    "@oracledesk/bindings-reasoning-registry": "*"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5.3"
  },
  "engines": {
    "node": ">=18"
  }
}
